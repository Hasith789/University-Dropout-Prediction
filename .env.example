# ========================================================
# MongoDB Atlas / Local Connection Configuration Template
# Copy this file to .env and configure your real credentials.
# DO NOT commit .env with real credentials to source control.
# ========================================================

# Option 1: MongoDB Atlas Connection URI
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Option 2: Local MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017

# Target database name
MONGODB_DATABASE=university_dropout_db
